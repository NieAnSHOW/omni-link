{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and extractor windows",
  "windows": ["main", "extractor-*"],
  "remote": {
    "urls": ["https://**", "http://**"]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "opener:default"
  ]
}
